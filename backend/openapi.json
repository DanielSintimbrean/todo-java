{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Todo API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/todos" : {
      "get" : {
        "operationId" : "listTodos",
        "parameters" : [ {
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "COMPLETED" ]
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TodoResponse"
                  }
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Request inválida (validación, UUID mal formado, filtro desconocido...)"
          }
        },
        "summary" : "Lista los TODOs, opcionalmente filtrados por estado",
        "tags" : [ "todos" ]
      },
      "post" : {
        "operationId" : "createTodo",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateTodoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TodoResponse"
                }
              }
            },
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Request inválida (validación, UUID mal formado, filtro desconocido...)"
          }
        },
        "summary" : "Crea un TODO",
        "tags" : [ "todos" ]
      }
    },
    "/api/todos/{id}" : {
      "delete" : {
        "operationId" : "deleteTodo",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Borrado"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Request inválida (validación, UUID mal formado, filtro desconocido...)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No existe"
          }
        },
        "summary" : "Borra un TODO",
        "tags" : [ "todos" ]
      },
      "get" : {
        "operationId" : "getTodo",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TodoResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Request inválida (validación, UUID mal formado, filtro desconocido...)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No existe"
          }
        },
        "summary" : "Obtiene un TODO",
        "tags" : [ "todos" ]
      },
      "patch" : {
        "operationId" : "updateTodo",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateTodoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TodoResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Request inválida (validación, UUID mal formado, filtro desconocido...)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No existe"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "La versión enviada no es la actual: otra persona lo modificó antes"
          }
        },
        "summary" : "Modifica título y/o estado. Exige la versión actual (concurrencia optimista)",
        "tags" : [ "todos" ]
      }
    },
    "/api/todos/{id}/toggle" : {
      "post" : {
        "operationId" : "toggleTodo",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TodoResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Request inválida (validación, UUID mal formado, filtro desconocido...)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No existe"
          }
        },
        "summary" : "Alterna el estado completado",
        "tags" : [ "todos" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateTodoRequest" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "title" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "Error en formato RFC 9457 (application/problem+json)",
        "properties" : {
          "currentVersion" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Versión actual del recurso (solo en 409)"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            },
            "description" : "Errores de validación por campo (solo en 400)"
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "status", "title", "type" ]
      },
      "TodoResponse" : {
        "type" : "object",
        "properties" : {
          "completed" : {
            "type" : "boolean"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "title" : {
            "type" : "string"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "completed", "createdAt", "id", "title", "updatedAt", "version" ]
      },
      "UpdateTodoRequest" : {
        "type" : "object",
        "properties" : {
          "completed" : {
            "type" : "boolean"
          },
          "title" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0,
            "pattern" : ".*\\S.*"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Versión del TODO que el cliente está editando"
          }
        },
        "required" : [ "version" ]
      }
    }
  }
}
